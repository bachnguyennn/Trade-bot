# Copy to `.env` and adjust. Every value is optional; the defaults run without any keys.
# Never commit a real `.env` file.

# Where Bronze/Silver/Gold data, reports, models, and order state are stored.
TRADEBOT_DATA_DIR=data

# Posts
TRADEBOT_ACCOUNT=realDonaldTrump
# The `cnn` post source has unverified reuse terms. Read docs/DATA_SOURCES.md before enabling.
TRADEBOT_ALLOW_UNVERIFIED_SOURCES=false

# Point-in-time rules
TRADEBOT_ASSUMED_LATENCY_SECONDS=60
TRADEBOT_DECISION_LATENCY_SECONDS=30
TRADEBOT_CLUSTER_GAP_MINUTES=60

# Market data: auto (Alpaca when keys are set, otherwise yfinance), alpaca, or yfinance.
TRADEBOT_MARKET_PROVIDER=auto
TRADEBOT_ALPACA_API_KEY=
TRADEBOT_ALPACA_API_SECRET=
TRADEBOT_BENCHMARK_SYMBOL=SPY

# Backtesting defaults
TRADEBOT_COST_BPS=1.0
TRADEBOT_SLIPPAGE_BPS=2.0
TRADEBOT_MAX_POSITION_WEIGHT=0.10
TRADEBOT_MAX_GROSS_EXPOSURE=1.0

# Paper trading. `simulator` needs no account. `alpaca-paper` uses the keys above against
# the paper endpoint only. There is no live-trading option.
TRADEBOT_BROKER=simulator
TRADEBOT_PAPER_INITIAL_CASH=100000
TRADEBOT_DAILY_LOSS_LIMIT_PCT=0.02
TRADEBOT_ENFORCE_MARKET_HOURS=true
